<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
    Suppression file for the CVE scan (org.owasp:dependency-check-maven), passed
    via -DsuppressionFiles in .github/workflows/cve-scanning.yml.

    To suppress a finding, add an entry like:

    <suppress>
        <notes><![CDATA[
        Reason for suppression goes here
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/group\.id/artifact\-id@.*$</packageUrl>
        <cve>CVE-YYYY-NNNN</cve>
    </suppress>

    Or suppress by CWE:

    <suppress>
        <notes><![CDATA[
        Reason for suppression goes here
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/group\.id/artifact\-id@.*$</packageUrl>
        <cwe>79</cwe>
    </suppress>

    For more information on the suppression file format, see:
    https://dependency-check.github.io/DependencyCheck/general/suppression.html
    -->
</suppressions>
